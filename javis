const cmd = t.replace("hey jarvis", "").replace("jarvis", "").trim();
      
      if (cmd.includes("work")  cmd.includes("dashboard")  cmd.includes("open") || t.includes("work mode")) {
        toggleWorkMode(true);
        say(Work mode activated, ${getRandomName(true)}.);
      } else if (cmd.includes("exit")  cmd.includes("close")  cmd.includes("stop")) {
        toggleWorkMode(false);
        say(Closing dashboard, ${getRandomName(true)}.);
      } else if (cmd) {
        addMsg("Jorim: " + t, "user");
        handleCommand(cmd);
      } else {
        say(Yes, ${getRandomName(true)}?);
      }
    }
  };
}

function manualActivate() {
  setupMic();
  if (rec) {
    rec.shouldBeListening = true;
    try { rec.start(); } catch(e) {}
  }
  say(Yes, ${getRandomName(true)}?);
}

function toggleWorkMode(active) {
  if (active) { dashboard.classList.add("active"); } 
  else { dashboard.classList.remove("active"); }
}

function addMsg(text, sender) {
  const div = document.createElement("div");
  div.className = "msg " + sender;
  div.innerText = text;
  document.getElementById("chat-log").appendChild(div);
}

document.body.addEventListener('click', () => {
  setupMic();
  if (rec && !rec.isStarted) {
    rec.shouldBeListening = true;
    try { rec.start(); rec.isStarted = true; } catch(e) {}
  }
}, { once: true });

setInterval(() => { document.getElementById("clock").innerText = new Date().toLocaleTimeString(); }, 1000);

async function handleCommand(cmd) {
  if (cmd.includes("investment")) { finances.investments += 100; updateKPIUI(); return say(Investment updated, ${getRandomName(true)}.); }
  if (cmd.includes("income")) { finances.income += 100; updateKPIUI(); return say(Income updated, ${getRandomName(true)}.); }
  if (cmd.includes("expense")) { finances.expenses += 100; updateKPIUI(); return say(Expenses updated, ${getRandomName(true)}.); }
  setTimeout(() => { say(Processing: ${cmd}); }, 500);
}
</script>
